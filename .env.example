# Copy this file to .env for local (non-Docker) development.
# Inside Docker Compose these are supplied via docker-compose.yml/`.env` at the repo root.

NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_USER=linksphere
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=linksphere
DATABASE_URL=postgresql://linksphere:change_me_in_prod@localhost:5432/linksphere?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth — must be at least 32 characters, generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_32_plus_character_secret
JWT_EXPIRES_IN=1h

# Shared HMAC secret used to sign/verify the simulated payment webhook.
# Must be at least 32 characters, generate with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=replace_with_a_random_32_plus_character_secret

# Redis sliding-window rate limiter for GET /api/v1/streams/active
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# Cache-aside TTL for stream metadata
STREAM_CACHE_TTL_SECONDS=10

# BullMQ media moderation queue retry policy
MEDIA_QUEUE_JOB_ATTEMPTS=3
MEDIA_QUEUE_BACKOFF_MS=2000
